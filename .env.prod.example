# Production hosted stack secrets — copy to .env.prod, fill in real values,
# never commit .env.prod to git.
#
# Used by: docker-compose.prod.yml
# For self-hosted single-instance SQLite deployments, use .env.example instead.

# ── Container Image ───────────────────────────────────────────────────────────
# Required. Set to the WhitePact image built/published for your deployment.
WHITEPACT_IMAGE=
# RAI_IMAGE=  # legacy fallback

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=responsibleai
POSTGRES_USER=rai_user
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ── Application ───────────────────────────────────────────────────────────────
WHITEPACT_API_KEYS=CHANGE_ME_or_use_org-scoped_DB_keys_instead
# RAI_API_KEYS=  # legacy fallback
WHITEPACT_ALLOWED_ORIGINS=https://your-dashboard.example.com
# RAI_ALLOWED_ORIGINS=  # legacy fallback
WHITEPACT_ALERT_THRESHOLD=5.0
WHITEPACT_MONTHLY_BUDGET_USD=10000.0
WHITEPACT_WORKERS=4

# ── Hosted MCP OAuth 2.1 (required for ChatGPT connections) ───────────────────
# Both values must use the exact public HTTPS origin used by clients.
# WHITEPACT_MCP_OAUTH_ISSUER=https://your-mcp.example.com
# WHITEPACT_MCP_OAUTH_RESOURCE_URI=https://your-mcp.example.com/mcp
# WHITEPACT_MCP_OAUTH_SCOPES=whitepact:review,offline_access
# WHITEPACT_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# WHITEPACT_MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Keep WHITEPACT_MCP_HTTP_ALLOW_UNAUTHENTICATED_DEMO=false in production.

# ── SSO / OIDC (optional) ───────────────────────────────────────────────────────
# WHITEPACT_OIDC_ISSUER=https://your-idp.example.com
# WHITEPACT_OIDC_CLIENT_ID=
# WHITEPACT_OIDC_CLIENT_SECRET=
# WHITEPACT_OIDC_REDIRECT_URI=https://your-dashboard.example.com/api/auth/callback

# ── Paddle billing (production provider for PRO/ENTERPRISE) ───────────────────
# WHITEPACT_PADDLE_ENV=production
# WHITEPACT_PADDLE_API_KEY=pdl_live_apikey_...
# WHITEPACT_PADDLE_WEBHOOK_SECRET=whsec_...
# WHITEPACT_PADDLE_PRICE_ID_PRO=pri_...
# WHITEPACT_PADDLE_PRICE_ID_ENTERPRISE=pri_...
# WHITEPACT_BILLING_SUCCESS_URL=https://your-dashboard.example.com/billing/success
# WHITEPACT_BILLING_CANCEL_URL=https://your-dashboard.example.com/billing/cancel

# ── Stripe billing (non-production dev fallback only; not used when WHITEPACT_ENV=production) ─
# WHITEPACT_STRIPE_SECRET_KEY=sk_test_...
# WHITEPACT_STRIPE_WEBHOOK_SECRET=whsec_...
# WHITEPACT_STRIPE_PRICE_ID_PRO=price_...
# WHITEPACT_STRIPE_PRICE_ID_ENTERPRISE=price_...

# ── Telemetry (optional) ────────────────────────────────────────────────────────
# WHITEPACT_OTEL_ENDPOINT=http://otel-collector:4318
# WHITEPACT_OTEL_SERVICE_NAME=whitepact-prod
