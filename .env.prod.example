# Production hosted stack secrets — copy to .env.prod, fill in real values,
# never commit .env.prod to git.
#
# Used by: docker-compose.prod.yml
# For self-hosted single-instance SQLite deployments, use .env.example instead.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=responsibleai
POSTGRES_USER=rai_user
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ── Application ───────────────────────────────────────────────────────────────
WHITEPACT_API_KEYS=CHANGE_ME_or_use_org-scoped_DB_keys_instead
WHITEPACT_ALLOWED_ORIGINS=https://your-dashboard.example.com
WHITEPACT_ALERT_THRESHOLD=5.0
WHITEPACT_MONTHLY_BUDGET_USD=10000.0
WHITEPACT_WORKERS=4

# ── SSO / OAuth 2.1 (required for production hosted MCP) ──────────────────────
WHITEPACT_OIDC_ISSUER=https://your-idp.example.com
WHITEPACT_MCP_OAUTH_RESOURCE_URI=https://your-mcp.example.com/mcp
WHITEPACT_MCP_OAUTH_SCOPES=mcp:tools
WHITEPACT_MCP_HTTP_ALLOWED_HOSTS=your-mcp.example.com
WHITEPACT_MCP_HTTP_ALLOWED_ORIGINS=https://your-dashboard.example.com
WHITEPACT_MCP_HTTP_DNS_REBINDING_PROTECTION=true
WHITEPACT_MCP_HTTP_AUTH_MAX_FAILURES=10
WHITEPACT_MCP_HTTP_AUTH_WINDOW_SECONDS=60
# WHITEPACT_OIDC_CLIENT_ID=
# WHITEPACT_OIDC_CLIENT_SECRET=
# WHITEPACT_OIDC_REDIRECT_URI=https://your-dashboard.example.com/api/auth/callback

# ── Stripe billing (required to sell PRO/ENTERPRISE plans) ─────────────────────
# RAI_STRIPE_SECRET_KEY=sk_live_...
# RAI_STRIPE_WEBHOOK_SECRET=whsec_...
# RAI_STRIPE_PRICE_ID_PRO=price_...
# RAI_STRIPE_PRICE_ID_ENTERPRISE=price_...
# RAI_BILLING_SUCCESS_URL=https://your-dashboard.example.com/billing/success
# RAI_BILLING_CANCEL_URL=https://your-dashboard.example.com/billing/cancel

# ── Telemetry (optional) ────────────────────────────────────────────────────────
# RAI_OTEL_ENDPOINT=http://otel-collector:4318
# RAI_OTEL_SERVICE_NAME=whitepact-prod
