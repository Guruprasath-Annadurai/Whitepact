      "negotiation_name": "xray",
      "availability": "AVAILABLE",
      "authentication": "org body",
      "zero_effect": true,
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/sovereign/xray"
        },
        {
          "method": "POST",
          "path": "/api/web/sovereign/xray"
        }
      ],
      "request_schema": {
        "$ref": "#/$defs/OrgBody"
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "unknown_behavior": "truncation flags remain explicit in graph",
      "unavailable_behavior": "HTTP 501",
      "browser_authentication": "wp_session cookie + X-WP-CSRF header on POST",
      "browser_request_schema": {
        "$ref": "#/$defs/WebTenantBody"
      }
    },
    {
