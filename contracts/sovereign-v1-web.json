{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocol_version": "1.0.0",
  "sovereign_version": "1.0.0",
  "error_model": {
    "400": {
      "description": "invalid request body or missing required fields"
    },
    "404": {
      "description": "tenant isolation violation or resource not found for organization"
    },
    "501": {
      "description": "capability UNAVAILABLE on this deployment"
    },
    "5xx": {
      "description": "internal error \u2014 disposition ERROR in clients"
    }
  },
  "tenant_behavior": {
    "internal_api": "organization_id required on /api/sovereign/* request bodies; cross-tenant access returns HTTP 404",
    "browser_api": "tenant derived from authenticated wp_session; browser-supplied organization_id rejected with HTTP 400",
    "principal_id": "optional on internal API only; web API sets principal_id from session server-side"
  },
  "zero_effect_operations": [
    "simulate_blast_radius",
    "simulate_mission",
    "shadow",
    "policy_lint",
    "policy_test",
    "policy_diff",
    "policy_simulate",
    "gauntlet",
    "flight_recorder",
    "time_machine",
    "evidence_correlation",
    "capsule_create",
    "capsule_validate",
    "capsule_reproduce"
  ],
  "$defs": {
    "OrgBody": {
      "type": "object",
      "required": [
        "organization_id"
      ],
      "properties": {
        "organization_id": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "default": "development"
        },
        "principal_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CapabilityAvailability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "EXPERIMENTAL"
      ]
    },
    "MissionDisposition": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "APPROVAL_REQUIRED",
        "UNKNOWN",
        "UNREACHABLE"
      ]
    },
    "GauntletStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "UNAVAILABLE"
      ]
    },
    "TraceStageStatus": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "UNKNOWN"
      ]
    },
    "SovereignStatus": {
      "type": "object",
      "required": [
        "sovereign_version",
        "protocol_version"
      ],
      "properties": {
        "sovereign_version": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        }
      }
    },
    "FeatureDescriptor": {
      "type": "object",
      "required": [
        "name",
        "availability"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/CapabilityAvailability"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "read_only": {
          "type": "boolean"
        },
        "simulation": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SovereignCapabilities": {
      "type": "object",
      "required": [
        "sovereign_version",
        "protocol_version",
        "features"
      ],
      "properties": {
        "sovereign_version": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureDescriptor"
          }
        }
      }
    },
    "PolicyRule": {
      "type": "object",
      "description": "Governance PolicyRule JSON shape",
      "additionalProperties": true
    },
    "Capsule": {
      "type": "object",
      "required": [
        "capsule_id",
        "digest",
        "organization_id"
      ],
      "properties": {
        "capsule_id": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "WebTenantBody": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "default": "development"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "organization_id"
        ]
      }
    }
  },
  "capabilities": [
    {
      "feature_id": "status",
      "feature_version": "1.0.0",
      "negotiation_name": "status",
      "availability": "AVAILABLE",
      "authentication": "none for GET /api/web/sovereign/status and /capabilities; web_session+csrf for other browser POST routes",
      "zero_effect": true,
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/sovereign/status"
        },
        {
          "method": "GET",
          "path": "/api/web/sovereign/status"
        }
      ],
      "request_schema": null,
      "response_schema": {
        "$ref": "#/$defs/SovereignStatus"
      },
      "unknown_behavior": "N/A",
      "unavailable_behavior": "HTTP 501 if capability disabled"
    },
    {
      "feature_id": "capabilities",
      "feature_version": "1.0.0",
      "negotiation_name": null,
      "availability": "AVAILABLE",
      "authentication": "none for GET /api/web/sovereign/status and /capabilities; web_session+csrf for other browser POST routes",
      "zero_effect": true,
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/sovereign/capabilities"
        },
        {
          "method": "GET",
          "path": "/api/web/sovereign/status"
        },
        {
          "method": "GET",
          "path": "/api/web/sovereign/capabilities"
        }
      ],
      "request_schema": null,
      "response_schema": {
        "$ref": "#/$defs/SovereignCapabilities"
      },
      "unknown_behavior": "N/A",
      "unavailable_behavior": "HTTP 501"
    },
    {
